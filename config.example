# Nonce Engine settings
# setup.sh copies this file to "config". Fill in your own values there.

# Your Bitcoin address (where any block reward goes)
BTC_ADDRESS=bc1qyouraddresshere

# Solo mining pool
POOL_URL=stratum+tcp://solo.ckpool.org:3333

# Number of CPU threads to mine with. Leave blank to use all cores but one (3 on a Pi 2)
THREADS=

# Telegram weekly report (filled in later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=